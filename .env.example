# EventNow — environment variables.
# Copy to .env and fill in. .env is gitignored; this file is not.

# --- Django core ---------------------------------------------------------
SECRET_KEY=any-random-string-for-dev
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# --- Database ------------------------------------------------------------
# Omit for the SQLite fallback. Production is a Neon pooled Postgres URL.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- LLM ("Polish with AI") ----------------------------------------------
# Any OpenAI-compatible provider. LLM_MODEL and LLM_BASE_URL are optional and
# default to Groq's openai/gpt-oss-20b; they are env vars rather than literals
# so a provider retiring a model is a dashboard edit, not a redeploy.
LLM_API_KEY=your-groq-or-openai-key
# LLM_MODEL=openai/gpt-oss-20b
# LLM_BASE_URL=https://api.groq.com/openai/v1

# --- Media storage (Cloudinary) ------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Google OAuth --------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (allauth) -----------------------------------------------------
# Unset EMAIL_HOST falls back to the console backend.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=EventNow <no-reply@example.com>

# --- Observability -------------------------------------------------------
# Externally shared Grafana dashboard; /status/ 302s to it (404 when unset).
# STATUS_DASHBOARD_URL=https://<stack>.grafana.net/public-dashboards/<token>

# --- Observability (V2, OpenTelemetry -> Grafana Cloud) ------------------
# Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to disable telemetry entirely.
# OTEL_SERVICE_NAME=eventnow
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64-instanceID:token>
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Keep the monitor's own probes out of the RED metrics.
# OTEL_PYTHON_DJANGO_EXCLUDED_URLS=healthz,readyz

# --- Injected by Render at runtime (do not set locally) ------------------
# RENDER_GIT_COMMIT
